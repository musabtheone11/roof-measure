[Unit]
Description=Diversity Roof local report organization
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/REPLACE/roof-measure
Environment=ROOF_DOWNLOADS=/REPLACE/Downloads
Environment=ROOF_ORG_STATE=/REPLACE/private-state
ExecStart=/REPLACE/node --use-env-proxy organization/cli.mjs start
Restart=on-failure
RestartSec=10
TimeoutStopSec=130
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
